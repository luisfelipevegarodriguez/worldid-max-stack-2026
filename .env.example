# Copy to .env.local for local dev. Leave values empty to build and boot in degraded mode.
# Never commit .env or .env.local. Placeholders below are documentation, not secrets.

# Public (inlined into the browser at build time).
# Real value from https://developer.world.org — looks like app_ followed by hex.
NEXT_PUBLIC_WORLD_APP_ID=
NEXT_PUBLIC_WORLD_ENVIRONMENT=production
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Server-only World ID. Empty -> verify routes return 503 world_unconfigured.
WORLD_RP_ID=
# RP signing key (hex). Server-only. Empty -> /api/rp-signature returns 503.
WORLD_SIGNING_KEY=
ALLOW_LEGACY_PROOFS=false

# Session JWT for /api/agent/trigger. Empty -> session route returns 503 jwt_unconfigured.
# Generate with: openssl rand -hex 32
JWT_SECRET=

# Database. Provide DATABASE_URL (Supabase Postgres) or the Supabase REST pair.
# Build does not connect. Runtime verify persists when one of these is set.
# Supabase dashboard -> Project Settings -> Database -> URI
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional. Without these, rate limiting is an in-memory window on that instance.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional n8n (or any) webhook. Empty -> /api/agent/trigger returns 503.
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=

# services/backend and services/growth-agent. Not read by apps/web.
WORLD_CHAIN_RPC_URL=
PAYMENT_ROUTER_ADDR=
CRON_SECRET=
OPENAI_API_KEY=
BACKEND_URL=
