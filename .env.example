# World ID
WORLD_APP_ID=app_xxxxxxxxxxxx
WORLD_RP_ID=rp_xxxxxxxxxxxx
WORLD_SIGNING_KEY=sk_xxxxxxxxxxxx   # NEVER expose — backend only, store in Secret Manager

# Database
DATABASE_URL=postgresql://user:pass@host:5432/worldid

# Auth
JWT_SECRET=your_jwt_secret_here

# Upstash Redis (rate limiting)
UPSTASH_REDIS_REST_URL=https://xxx.upstash.io
UPSTASH_REDIS_REST_TOKEN=xxx

# n8n
N8N_WEBHOOK_URL=https://n8n.your-domain.com
N8N_WEBHOOK_SECRET=your_n8n_webhook_secret

# Zoom (OAuth)
ZOOM_CLIENT_ID=xxx
ZOOM_CLIENT_SECRET=xxx
ZOOM_ACCOUNT_ID=xxx

# DocuSign
DOCUSIGN_INTEGRATION_KEY=xxx
DOCUSIGN_USER_ID=xxx
DOCUSIGN_ACCOUNT_ID=xxx
DOCUSIGN_PRIVATE_KEY_PATH=./certs/docusign.pem

# GitHub (for dispatch)
GITHUB_PAT=ghp_xxx
